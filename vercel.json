{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "GITHUB_TOKEN": "@github_token",
    "GIST_ID": "@gist_id",
    "BOT_TOKEN": "@bot_token",
    "CHANNEL_ID": "@channel_id"
  }
}